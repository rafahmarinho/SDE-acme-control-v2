# Server-side only (Vercel project env vars, marked "Sensitive"). Never expose to the Flutter client.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
# Comma-separated EXACT origins allowed by CORS. No wildcards.
ALLOWED_ORIGINS=http://localhost:5173,https://<your-web>.vercel.app
# Demo tooling (scenarios / step / reset). Keep false in production.
ENABLE_DEMO_TOOLS=false

# Server-side only (Vercel project env vars). Never expose to the Flutter client.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
SUPABASE_JWT_AUDIENCE=authenticated
# Comma-separated exact origins allowed by CORS (skills/web-security/T257)
ALLOWED_ORIGINS=http://localhost:5173,https://<your-web>.vercel.app
# Demo tooling (scenarios/step/reset) - disable in production (skills/release-supply-chain/T49)
ENABLE_DEMO_TOOLS=false

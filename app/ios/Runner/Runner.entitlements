<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Data Protection: files are encrypted and unavailable while the device is locked.
     No iCloud, CloudKit or iCloud key-value entitlements: Supabase is the only backend.
     Universal Link limited to the web host (replace before release; path filtering is in
     the apple-app-site-association file on the web host: only /auth/callback). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:REPLACE_WITH_WEB_HOST</string>
	</array>
</dict>
</plist>

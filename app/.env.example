# Copy to .env.production.json as {"KEY": "value"} and pass with --dart-define-from-file.
# Only PUBLIC values belong in the client. Never put the Supabase service-role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key>
API_BASE_URL=https://<your-api>.vercel.app
# Must match an entry in Supabase Auth "Redirect URLs" exactly (web URL or verified App/Universal Link).
RESET_REDIRECT_URL=https://<your-web>.vercel.app/auth/callback
# Demo/simulation tooling. The app refuses to start in release mode if this is true.
ENABLE_DEMO_TOOLS=false
